# TRACE Environment Variables
# Appendix B

# Detection provider: "mock" (offline dev) or "sightengine" (production)
DETECTION_PROVIDER=mock

# Set to true to display the DEMO MODE badge in the UI
NEXT_PUBLIC_DEMO_MODE=true

# Sightengine API credentials (required if DETECTION_PROVIDER=sightengine)
# Server-side only: never prefix with NEXT_PUBLIC_
SIGHTENGINE_API_USER=
SIGHTENGINE_API_SECRET=

# Anthropic API credentials for ADRIA assistant (server-side only)
ANTHROPIC_API_KEY=

# ADRIA model ID
ADRIA_MODEL=claude-3-5-sonnet-20241022

# Optional Machine-Learning Localization Microservice (Server-side only)
# Leave empty to run on-device classical fusion only
FORENSICS_SERVICE_URL=
FORENSICS_SERVICE_TOKEN=

# Client flag to indicate ML service status for privacy disclosure copy
NEXT_PUBLIC_FORENSICS_SERVICE_ENABLED=false
